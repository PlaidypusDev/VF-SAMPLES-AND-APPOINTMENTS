	                    html_notes += "<li class='list-group-item'>" + value + "</li>";
	                });

			// Concatenate the strings.
			var nested_html = `
				<div class='collapse expand-collapse-info expand-collapse-${order_number}' style='padding-top: 0.75rem;'>
